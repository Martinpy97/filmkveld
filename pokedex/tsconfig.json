{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "esnext"], "strict": true,
    "module": "esnext", "moduleResolution": "bundler", "jsx": "react-jsx", "noEmit": true,
    "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "paths": { "@/*": ["./*"] }, "types": ["node"]
  },
  "include": ["**/*.ts", "**/*.tsx"], "exclude": ["node_modules", "dist"]
}
